{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": { "analytics": false, "cache": { "path": ".cache/angular" } },
  "projects": {
    "azdo-sprint-timeline": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist/azdo-sprint-timeline",
            "index": "src/index.html",
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "styles": ["src/styles.css"],
            "assets": [
              { "glob": "**/*", "input": "src/assets", "output": "assets" }
            ],
            "budgets": [
              {
                "type": "initial",
                "maximumWarning": "2MB",
                "maximumError": "3MB"
              }
            ]
          }
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": { "buildTarget": "azdo-sprint-timeline:build" }
        }
      }
    }
  }
}
