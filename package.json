{
  "name": "azdo-sprint-timeline",
  "version": "0.3.1",
  "private": true,
  "displayName": "Sprint Timeline",
  "description": "A read-only Azure Boards Sprint timeline aggregated from child Tasks.",
  "publisher": "mm-lab",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mm-lab-dev/azdo-sprint-timeline.git"
  },
  "bugs": {
    "url": "https://github.com/mm-lab-dev/azdo-sprint-timeline/issues"
  },
  "homepage": "https://github.com/mm-lab-dev/azdo-sprint-timeline#readme",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10"
  },
  "scripts": {
    "start:mock": "node scripts/angular.mjs serve --host 127.0.0.1 --port 4200",
    "assets:listing": "node scripts/listing-assets.mjs",
    "assets:avatars": "node scripts/avatar-assets.mjs",
    "build": "node scripts/angular.mjs build --base-href ./",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write src fixtures e2e docs scripts *.json *.md *.mjs *.cjs *.ts",
    "format:check": "prettier --check src fixtures e2e docs scripts *.json *.md *.mjs *.cjs *.ts",
    "test": "jest --runInBand",
    "test:e2e": "playwright test",
    "package:vsix": "npm run build && node scripts/package.mjs"
  },
  "dependencies": {
    "@angular/common": "21.2.26",
    "@angular/compiler": "21.2.26",
    "@angular/core": "21.2.26",
    "@angular/forms": "21.2.26",
    "@angular/platform-browser": "21.2.26",
    "@primeuix/themes": "^2.0.0",
    "azure-devops-extension-api": "5.281.0",
    "azure-devops-extension-sdk": "4.2.0",
    "primeng": "21.1.10",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "21.2.26",
    "@angular/cli": "21.2.31",
    "@angular/compiler-cli": "21.2.26",
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.57.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.19.0",
    "eslint": "^9.39.0",
    "jest": "^30.2.0",
    "prettier": "^3.7.0",
    "tfx-cli": "^0.22.0",
    "ts-jest": "^29.4.5",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0"
  }
}
